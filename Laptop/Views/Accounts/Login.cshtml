@model LaptopShop.Models.User

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main-content">
    <div class="login-register-area section-space-y-axis-100">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 pt-10 pt-lg-0">
                    <form asp-action="Login">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="login-form">
                            <h1 class="login-title">Đăng nhập</h1>
                            <div class="row">
                                <div class="col-md-12">
                                    <label>Email</label>
                                    <input type="text" asp-for="Email" placeholder="Email">
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-12">
                                    <label>Mật khẩu</label>
                                    <input type="password" asp-for="Password" placeholder="Mật khẩu">
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>
                                <div class="col-12 btn-login">
                                    <button class="btn btn-custom-size lg-size btn-secondary btn-primary-hover rounded-0 btn-login">Đăng nhập</button>
                                </div>
                                <div class="col-12 text-center pt-3">
                                    <a href="/quen-mat-khau">Quên mật khẩu?</a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>

@section Styles {
    <style>
        .btn-login, h1 {
            margin-bottom: 10px;
            text-align: center;
        }
        a {
            display: inline-block;
            text-decoration: none;
            font-weight: bold;
            color: red;
        }

        .text-center a:hover {
            text-decoration: underline;
            color: blue;
        }
    </style>
}