@model LaptopShop.Models.User

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section>
    <div class="container mt-4">
        <div class="row">
            <!-- Menu -->
            <div class="col-md-3">
                <div class="menu">
                    <a data-name="Thông tin tài khoản" class="active" onclick="setActive(this)"> Thông tin tài khoản</a>
                    <a data-name="Danh sách đơn hàng" onclick="setActive(this)"> Danh sách đơn hàng</a>
                    <a data-name="Thay đổi thông tin" onclick="setActive(this)"> Thay đổi thông tin</a>
                    <a data-name="Đổi mật khẩu" onclick="setActive(this)"> Đổi mật khẩu</a>
                    <a href="/dang-xuat"> Đăng xuất</a>
                </div>
            </div>

            <div class="col-md-9">
                @await Html.PartialAsync("_InformationPartialView", Model)
            </div>
        </div>
    </div>
</section>

<style>
    .menu {
        background-color: #96919138;
        color: white;
        padding: 15px;
        height: 100%;
        border-radius: 5px;
    }

        .menu a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 10px 15px;
            margin-bottom: 10px;
            border-radius: 5px;
            background-color: #000;
            text-align: center;
        }

            .menu a:hover {
                background-color: #D10024;
                cursor: pointer;
            }

            .menu a.active {
                background-color: #D10024;
                color: white;
                font-weight: bold;
            }
</style>

<script>
    function setActive(element) {
        document.querySelectorAll('.menu a').forEach(a => a.classList.remove('active'));
        element.classList.add('active');

        const name = element.getAttribute('data-name');

        $.ajax({
            url: '/Accounts/GetDashboardInfo',
            type: 'GET',
            data: { title: name },
            success: function (data) {
                $('.col-md-9').html(data);
            },
            error: function () {
                alert('Có lỗi xảy ra khi tải dữ liệu.');
            }
        });
    }

    function setDirect(element) {
        
        const name = element.getAttribute('data-name');
        const id = element.getAttribute('data-id');

        $.ajax({
            url: '/Accounts/GetDashboardInfo',
            type: 'GET',
            data: { title: name, orderId: id },
            success: function (data) {
                $('.col-md-9').html(data);
            },
            error: function () {
                alert('Có lỗi xảy ra khi tải dữ liệu.');
            }
        });
    }

    function cancelOrder(orderId) {
        if (confirm('Bạn có chắc chắn muốn hủy đơn hàng này?')) {
            $.ajax({
                url: '/Accounts/CancelOrder',
                type: 'POST',
                data: { orderId: orderId },
                success: function (data) {
                    $('.col-md-9').html(data);
                },
                error: function () {
                    alert('Đã có lỗi xảy ra khi hủy đơn hàng.');
                }
            });
        }
    }
</script>
