@model LaptopShop.ModelViews.ChangePasswordViewModel

<div class="myaccount-details">
    <form asp-controller="Accounts" asp-action="ChangePassword" method="post" class="myaccount-form">
        <div class="myaccount-form-inner">
            <div class="single-input">
                <label>Mật khẩu hiện tại</label>
                <input asp-for="PasswordNow" type="password" placeholder="Mật khẩu hiện tại">
                <span asp-validation-for="PasswordNow" class="text-danger"></span>
            </div>
            <div class="single-input">
                <label>Mật khẩu mới</label>
                <input type="password" asp-for="PasswordNew" placeholder="Mật khẩu mới">
                <span asp-validation-for="PasswordNew" class="text-danger"></span>
            </div>
            <div class="single-input">
                <label>Nhập lại mật khẩu mới</label>
                <input type="password" asp-for="ConfirmPasswordNew" placeholder="Nhập lại mật khẩu mới">
                <span asp-validation-for="ConfirmPasswordNew" class="text-danger"></span>
            </div>
            <div class="single-input">
                <button class="btn btn-custom-size lg-size btn-secondary btn-primary-hover rounded-0" type="submit">
                    <span>Lưu thay đổi</span>
                </button>
            </div>
        </div>
    </form>
</div>
