@model LaptopShop.ModelViews.ChangePasswordViewModel

<form asp-controller="Accounts" asp-action="NewPassword" method="post" class="myaccount-form">
        <div class="myaccount-form-inner">
            <div class="single-input">
                <label>Mật khẩu mới</label>
                <input type="password" asp-for="NewPassword" placeholder="Mật khẩu mới">
            <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="single-input">
                <label>Nhập lại mật khẩu mới</label>
                <input type="password" asp-for="ConfirmPassword" placeholder="Nhập lại mật khẩu mới">
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="single-input">
                <button class="btn btn-custom-size lg-size btn-secondary btn-primary-hover rounded-0" type="submit">
                    <span>Lưu thay đổi</span>
                </button>
            </div>
        </div>
    </form>
