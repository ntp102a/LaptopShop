@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<LaptopShop.Models.Product>

@{
    ViewData["Title"] = "Shop - " /*+ ViewBag.CurrentPages*/;
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<Product> allProducts = ViewBag.lsProduct;

    //int PageCurrent = ViewBag.CurrentPages;
    //int NextPage = PageCurrent + 1;
}

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <div class="col-md-12">
                <ul class="breadcrumb-tree">
                    <li><a href="/">Trang chủ</a></li>
                    <li>Tất cả sản phẩm</li>
                </ul>
            </div>
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /BREADCRUMB -->
<!-- SECTION -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <!-- Filter -->
            <div id="aside" class="col-md-3">
                <!-- Filter theo giá -->
                @*<div class="aside">
                    <h3 class="aside-title">Price</h3>
                    <div class="price-filter">
                        <div id="price-slider"></div>
                        <div class="input-number price-min">
                            <input id="price-min" type="number">
                            <span class="qty-up">+</span>
                            <span class="qty-down">-</span>
                        </div>
                        <span>-</span>
                        <div class="input-number price-max">
                            <input id="price-max" type="number">
                            <span class="qty-up">+</span>
                            <span class="qty-down">-</span>
                        </div>
                    </div>
                </div>*@

                <div class="aside">
                    <h3 class="aside-title">Hãng</h3>
                    <div class="checkbox-filter">
                        @foreach (var item in ViewBag.Categories)
                        {
                            <div class="input-checkbox">
                                <input type="checkbox" id="brand-@item.CategoryId" class="category-checkbox" data-category-id="@item.CategoryId">
                                <label for="brand-@item.CategoryId">
                                    <span></span>
                                    @item.CategoryName
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <!-- /aside Widget -->
            </div>
            <!-- END Filter -->
            <!-- STORE -->
            <div id="store" class="col-md-9">
                <!-- Sort -->
                <div class="store-filter clearfix">
                    <div class="store-sort">
                        <label>
                            Sort:
                            <select id="sortSelect" class="sort-select">
                                <option value="0">Tất cả</option>
                                <option value="1">Tăng dần theo giá</option>
                                <option value="2">Giảm dần theo giá</option>
                            </select>
                        </label>

                        @*<label>
                            Show:
                            <select id="pageSizeSelect" class="show-select">
                                <option value="12" selected>12</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </label>*@
                    </div>
                </div>
                <!-- End Sort -->

                <!-- List Products -->
                <div id="productList" class="row">
                    @await Html.PartialAsync("_ProductsPartialView", allProducts)
                </div>

                <!-- /store products -->
                <!-- store bottom filter -->
                @*<div class="store-filter clearfix">
                    <ul class="store-pagination">
                        @for (int i = 1; i <= Model.PageCount; i++)
                        {
                            <li class="@(i == ViewBag.CurrentPages ? "active" : "")">
                                @if (i != ViewBag.CurrentPages)
                                {
                                    <a href="@Url.RouteUrl("ShopProduct", new { page = i })">@i</a>
                                }
                                else
                                {
                                    <span>@i</span>
                                }
                            </li>
                        }
                    </ul>
                </div>*@
                <!-- /store bottom filter -->

            </div>
            <!-- /STORE -->
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /SECTION -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.category-checkbox').change(function () {
                const selectedCategories = [];
                $('.category-checkbox:checked').each(function () {
                    selectedCategories.push($(this).data('category-id'));
                });

                const selectedSort = $('#sortSelect').val();

                $.ajax({
                    url: '/Product/GetProductData',
                    type: 'GET',
                    data: {
                        categoryIds: selectedCategories,
                        sort: selectedSort 
                    },
                    traditional: true,
                    success: function (data) {
                        $('#productList').html(data);
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi tải dữ liệu.');
                    }
                });
            });

            $("#sortSelect").change(function () {
                var selectedSort = $(this).val();

                const selectedCategories = [];
                $('.category-checkbox:checked').each(function () {
                    selectedCategories.push($(this).data('category-id'));
                });

                $.ajax({
                    url: '/Product/GetProductData',
                    type: 'GET',
                    data: {
                        categoryIds: selectedCategories,
                        sort: selectedSort
                    },
                    traditional: true,
                    success: function (data) {
                        $('#productList').html(data);
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi tải dữ liệu.');
                    }
                });
            });
        });
    </script>
}


<style>
    .sort-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }

    .show-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }
</style>

