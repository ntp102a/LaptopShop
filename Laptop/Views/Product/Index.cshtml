@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<LaptopShop.Models.Product>

@{
    ViewData["Title"] = "Shop Laptop";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<Product> allProducts = ViewBag.lsProduct;
}

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <div class="col-md-12">
                <ul class="breadcrumb-tree">
                    <li><a href="/">Trang chủ</a></li>
                    <li>Tất cả sản phẩm</li>
                </ul>
            </div>
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /BREADCRUMB -->
<!-- SECTION -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <!-- Filter -->
            <div id="aside" class="col-md-3">
                
                <div class="aside">
                    <h3 class="aside-title">Hãng</h3>
                    <div class="checkbox-filter">
                        @foreach (var item in ViewBag.Categories)
                        {
                            <div class="input-checkbox">
                                <input type="checkbox" id="brand-@item.CategoryId" class="category-checkbox" data-category-id="@item.CategoryId">
                                <label for="brand-@item.CategoryId">
                                    <span></span>
                                    @item.CategoryName
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="aside">
                    <h3 class="aside-title">Nhu cầu sử dụng</h3>
                    <div class="checkbox-filter">
                        <div class="input-checkbox">
                            <input type="checkbox" id="vanphong" class="need-checkbox" data-need-id="1" value="Văn phòng">
                            <label for="vanphong"><span></span>Văn phòng</label>
                        </div>
                        <div class="input-checkbox">
                            <input type="checkbox" id="dohoa" class="need-checkbox" data-need-id="2" value="Đồ họa">
                            <label for="dohoa"><span></span>Đồ họa</label>
                        </div>
                        <div class="input-checkbox">
                            <input type="checkbox" id="laptrinh" class="need-checkbox" data-need-id="3" value="Lập trình">
                            <label for="laptrinh"><span></span>Lập trình</label>
                        </div>
                        <div class="input-checkbox">
                            <input type="checkbox" id="gaming" class="need-checkbox" data-need-id="4" value="Gaming">
                            <label for="gaming"><span></span>Gaming</label>
                        </div>
                    </div>
                </div>

            </div>
            <!-- END Filter -->
            <!-- STORE -->
            <div id="store" class="col-md-9">
                <!-- Sort -->
                <div class="store-filter clearfix">
                    <div class="store-sort">
                        <label>
                            Sort:
                            <select id="sortSelect" class="sort-select">
                                <option value="0">Tất cả</option>
                                <option value="1">Tăng dần theo giá</option>
                                <option value="2">Giảm dần theo giá</option>
                                <option value="3">Từ A - Z</option>
                                <option value="4">Từ Z - A</option>
                            </select>
                        </label>

                        @*<label>
                            Show:
                            <select id="pageSizeSelect" class="show-select">
                                <option value="12" selected>12</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </label>*@
                    </div>
                </div>
                <!-- End Sort -->

                <!-- List Products -->
                <div id="productList" class="row">
                    @await Html.PartialAsync("_ProductsPartialView", allProducts)
                </div>

                <!-- /store products -->
                <!-- store bottom filter -->
                @*<div class="store-filter clearfix">
                    <ul class="store-pagination">
                        @for (int i = 1; i <= Model.PageCount; i++)
                        {
                            <li class="@(i == ViewBag.CurrentPages ? "active" : "")">
                                @if (i != ViewBag.CurrentPages)
                                {
                                    <a href="@Url.RouteUrl("ShopProduct", new { page = i })">@i</a>
                                }
                                else
                                {
                                    <span>@i</span>
                                }
                            </li>
                        }
                    </ul>
                </div>*@
                <!-- /store bottom filter -->

            </div>
            <!-- /STORE -->
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /SECTION -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Hàm gửi dữ liệu lọc
            function applyFilters() {
                // Lấy danh sách các hãng được chọn
                const selectedCategories = [];
                $('.category-checkbox:checked').each(function () {
                    const categoryId = $(this).data('category-id');
                    if (categoryId) {
                        selectedCategories.push(categoryId); // Hãng
                    }
                });

                // Lấy danh sách nhu cầu sử dụng được chọn
                const selectedNeeds = [];
                $('.need-checkbox:checked').each(function () {
                    const needValue = $(this).val();
                    if (!$(this).data('category-id') && needValue) {
                        selectedNeeds.push(needValue); // Nhu cầu sử dụng
                    }
                });

                // Lấy thứ tự sắp xếp
                const selectedSort = $('#sortSelect').val();

                // Gửi dữ liệu qua AJAX
                $.ajax({
                    url: '/Product/GetProductData',
                    type: 'GET',
                    data: {
                        categoryIds: selectedCategories, // Hãng
                        needs: selectedNeeds, // Nhu cầu sử dụng
                        sort: selectedSort // Sắp xếp
                    },
                    traditional: true,
                    success: function (data) {
                        $('#productList').html(data); // Hiển thị sản phẩm
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi tải dữ liệu.');
                    }
                });
            }

            // Lắng nghe sự kiện thay đổi checkbox
            $('.category-checkbox').change(function () {
                applyFilters();
            });
            // Lắng nghe sự kiện thay đổi checkbox
            $('.need-checkbox').change(function () {
                applyFilters();
            });

            // Lắng nghe sự kiện thay đổi sắp xếp
            $("#sortSelect").change(function () {
                applyFilters();
            });
        });
    </script>
}


<style>
    .sort-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }

    .show-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }
</style>
