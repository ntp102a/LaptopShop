@model LaptopShop.ModelViews.MuaHangVM
@{
    ViewData["Title"] = "Thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<LaptopShop.Models.Cart> Carts = ViewBag.GioHang;
}

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <div class="col-md-12">
                <ul class="breadcrumb-tree">
                    <li><a href="/">Trang chủ</a></li>
                    <li class="active">Thanh toán</li>
                </ul>
            </div>
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /BREADCRUMB -->
<!-- SECTION -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <form asp-area="" asp-controller="Checkout" asp-action="Index" method="post">
            <input hidden asp-for="UserId" />
            <div class="row">
                <div class="col-md-7">
                    <!-- Billing Details -->
                    <div class="billing-details">
                        <div class="section-title">
                            <h3 class="title">Thông tin giao hàng</h3>
                        </div>
                        <div class="form-group">
                            <input asp-for="FullName" class="input" type="text" placeholder="Họ và tên" required>
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input asp-for="Email" class="input" type="email" placeholder="Email" required>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input asp-for="Address" class="input" type="text" placeholder="Địa chỉ" required>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input asp-for="Phone" class="input" type="tel" placeholder="Số điện thoại" required>
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>
                    <!-- /Billing Details -->
                    <!-- Order notes -->
                    <div class="order-notes">
                        <textarea asp-for="Note" name="Note" class="input" placeholder="Ghi chú"></textarea>
                    </div>
                    <!-- /Order notes -->
                </div>

                <!-- Order Details -->
                <div class="col-md-5 order-details">
                    <div class="section-title text-center">
                        <h3 class="title">Chi tiết đơn hàng</h3>
                    </div>

                    <div class="order-summary">
                        <div class="order-col">
                            <div><strong>Tên sản phẩm</strong></div>
                            <div><strong>Giá</strong></div>
                        </div>
                        <div class="order-products">
                            @if (Carts.Count() > 0)
                            {
                                foreach (var item in Carts)
                                {
                                    <div class="order-col">
                                        <div>
                                            <strong>
                                                × @item.Quantity
                                            </strong>
                                            @item.Product.ProductName
                                        </div>
                                        <div>@item.Product.Price.Value.ToString("#,##0") VNĐ</div>
                                    </div>
                                }
                            }

                        </div>
                        <div class="order-col">
                            <div>Phí giao hàng</div>
                            <div><strong>0 VNĐ</strong></div>
                        </div>
                        <div class="order-col">
                            <div><strong>TOTAL</strong></div>
                            <div class ="order-total"><strong>@Carts.Sum(x => x.TotalMoney).ToString("#,##0") VNĐ</strong></div>
                        </div>
                    </div>
                    @*<div class="payment-method">
                        <h1>Chọn phương thức thanh toán</h1>
                        <div class="input-radio">
                            <input type="radio" name="payment" id="payment-1">
                            <label for="payment-1">
                                <span></span>
                                Thanh toán khi nhận hàng
                            </label>
                        </div>
                        <div class="input-radio">
                            <input type="radio" name="payment" id="payment-2">
                            <label for="payment-2">
                                <span></span>
                                Chuyển khoản
                            </label>
                            <div class="caption">
                                <p>THÔNG TIN TÀI KHOẢN NGÂN HÀNG</p>
                                <p>CHỦ TÀI KHOẢN: NGUYEN TAN PHUOC</p>
                                <p>SỐ TÀI KHOẢN: 123456789 - Ngân hàng BIDV</p>
                                <p>NỘI DUNG CHUYỂN KHOẢN: Tên + Địa chỉ + Ngày đặt hàng</p>


                            </div>
                        </div>
                        <div class="input-radio">
                        <input type="radio" name="payment" id="payment-3">
                        <label for="payment-3">
                        <span></span>
                        Paypal System
                        </label>
                        </div>
                    </div>*@
                    <div class="order-button-payment">
                        <input value="XÁC NHẬN ĐẶT HÀNG" type="submit">
                    </div>
                    <a asp-action="PaypalCheckout">
                        <img src="~/images/paypal_checkout.gif" height="100" />
                    </a>
                </div>
                <!-- /Order Details -->
            </div>
        </form>

        <!-- /row -->
    </div>
    <!-- /container -->
</div>
