@model LaptopShop.ModelViews.HomeViewVM
@inject laptopWebContext _context
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Query


@{
    ViewData["Title"] = "Laptop Shop";
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<Product> allProducts = ViewBag.AllProducts;
    List<int?> productIds = ViewBag.TopProducts;
    List<Product> topProducts = _context.Products
        .AsNoTracking()
        .Include(p => p.Image)
        .Where(p => productIds.Contains(p.ProductId))
        .ToList();

}

<!-- SECTION NEW PRODUCT -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <!-- section title -->
            <div class="col-md-12">
                <div class="section-title">
                    <h3 class="title">TẤT CẢ SẢN PHẨM</h3>
                    <div class="section-nav">
                        <ul class="section-tab-nav tab-nav">
                            <li class="active"><a href="/tat-ca-san-pham">Xem thêm</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /section title -->
            <!-- Products tab & slick -->
            <div class="col-md-12">
                <div class="row">
                    <div class="products-tabs">
                        <!-- tab -->
                        <div id="tab1" class="tab-pane active">
                            <div class="products-slick" data-nav="#slick-nav-1">
                                @await Html.PartialAsync("_ListProductPartialView", allProducts)
                            </div>
                            <div id="slick-nav-1" class="products-slick-nav"></div>
                        </div>
                        <!-- /tab -->
                    </div>
                </div>
            </div>
            <!-- Products tab & slick -->
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- END SECTION NEW PRODUCT -->

<!-- SECTION TOP SELLING -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">

            <!-- section title -->
            <div class="col-md-12">
                <div class="section-title">
                    <h3 class="title">Top selling</h3>
                    <div class="section-nav">
                        <ul class="section-tab-nav tab-nav">
                            <li class="active"><a href="/tat-ca-san-pham">Xem thêm</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- /section title -->
            <!-- Products tab & slick -->
            <div class="col-md-12">
                <div class="row">
                    <div class="products-tabs">
                        <!-- tab -->
                        <div id="top-selling" class="tab-pane active">
                            <div class="products-slick" data-nav="#slick-nav-2">
                                @await Html.PartialAsync("_ListProductPartialView", topProducts)
                            </div>
                            <div id="slick-nav-2" class="products-slick-nav"></div>
                        </div>
                        <!-- /tab -->
                    </div>
                </div>
            </div>
            <!-- /Products tab & slick -->
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- END SECTION TOP SELLING -->
