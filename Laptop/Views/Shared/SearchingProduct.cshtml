@using PagedList.Core.Mvc
@model PagedList.Core.IPagedList<LaptopShop.Models.Product>

@{
    ViewData["Title"] = "LaptopShop";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<Product> searchProducts = ViewBag.ListProduct;

}

<!-- BREADCRUMB -->
<div id="breadcrumb" class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <div class="col-md-12">
                <ul class="breadcrumb-tree">
                    <li><a href="/">Trang chủ</a></li>
                    <li><a href="/tat-ca-san-pham">Tất cả sản phẩm</a></li>
                </ul>
            </div>
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /BREADCRUMB -->
<!-- SECTION -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <!-- Filter -->
            <div id="aside" class="col-md-3">

                <div class="aside">
                    <h3 class="aside-title">Giá tiền</h3>
                    <div class="price-filter">
                        <input type="range" id="price-range" min="0" max="80000000" step="1000000" value="80000000" class="price-slider">
                        <div class="price-values">
                            <span id="min-price">0</span> - <span id="max-price">80.000.000</span>
                        </div>
                    </div>
                </div>

                <div class="aside">
                    <h3 class="aside-title">Hãng</h3>
                    <div class="checkbox-filter">
                        @foreach (var item in ViewBag.Categories)
                        {
                            <div class="input-checkbox">
                                <input type="checkbox" id="brand-@item.CategoryId" class="category-checkbox" data-category-id="@item.CategoryId">
                                <label for="brand-@item.CategoryId">
                                    <span></span>
                                    @item.CategoryName
                                </label>
                            </div>
                        }
                    </div>
                </div>

                <div class="aside">
                    <h3 class="aside-title">Nhu cầu sử dụng</h3>
                    <div class="checkbox-filter">
                        <div class="input-checkbox">
                            <input type="checkbox" id="vanphong" class="need-checkbox" data-need-id="1" value="Văn phòng">
                            <label for="vanphong"><span></span>Văn phòng</label>
                        </div>
                        <div class="input-checkbox">
                            <input type="checkbox" id="dohoa" class="need-checkbox" data-need-id="2" value="Đồ họa">
                            <label for="dohoa"><span></span>Đồ họa</label>
                        </div>
                        <div class="input-checkbox">
                            <input type="checkbox" id="laptrinh" class="need-checkbox" data-need-id="3" value="Lập trình">
                            <label for="laptrinh"><span></span>Lập trình</label>
                        </div>
                        <div class="input-checkbox">
                            <input type="checkbox" id="gaming" class="need-checkbox" data-need-id="4" value="Gaming">
                            <label for="gaming"><span></span>Gaming</label>
                        </div>
                    </div>
                </div>
            </div>
            <!-- END Filter -->
            <!-- STORE -->
            <div id="store" class="col-md-9">
                <!-- Sort -->
                <div class="store-filter clearfix">
                    <div class="store-sort">
                        <label>
                            Sắp xếp:
                            <select id="sortSelect" class="sort-select">
                                <option value="0">Tất cả</option>
                                <option value="1">Tăng dần theo giá</option>
                                <option value="2">Giảm dần theo giá</option>
                                <option value="3">Từ A - Z</option>
                                <option value="4">Từ Z - A</option>
                            </select>
                        </label>
                    </div>
                </div>
                <!-- End Sort -->
                <!-- List Products -->
                <div id="productList" class="row">
                    @await Html.PartialAsync("_SearchProductPartialView", searchProducts)
                </div>

            </div>
            <!-- /STORE -->
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /SECTION -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

@section Scripts {
    <script>

        // Hàm để định dạng số tiền với dấu phẩy phân cách hàng nghìn
        function formatCurrency(amount) {
            return Number(amount).toLocaleString('vi-VN');
        }

        const priceSlider = document.getElementById('price-range');
        const minPrice = document.getElementById('min-price');
        const maxPrice = document.getElementById('max-price');

        // Cập nhật giá trị hiển thị khi người dùng thay đổi thanh trượt
        priceSlider.addEventListener('input', function () {
            let value = priceSlider.value;
            maxPrice.textContent = formatCurrency(value);
        });

        $(document).ready(function () {
            function fetchFilteredData() {
                const searchProductIds = @Html.Raw(Json.Serialize(searchProducts.Select(p => p.ProductId)));
                const selectedCategories = [];
                $('.category-checkbox:checked').each(function () {
                    selectedCategories.push($(this).data('category-id'));
                });

                const selectedNeeds = [];
                $('.need-checkbox:checked').each(function () {
                    selectedNeeds.push($(this).val());
                });

                const selectedSort = $('#sortSelect').val();

                const maxPrice = $('#price-range').val();

                $.ajax({
                    url: '/SearchProduct/GetProductData',
                    type: 'GET',
                    data: {
                        categoryIds: selectedCategories,
                        needs: selectedNeeds,
                        sort: selectedSort,
                        maxPrice: maxPrice,
                        productIds: searchProductIds
                    },
                    traditional: true,
                    success: function (data) {
                        $('#productList').html(data);
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi tải dữ liệu.');
                    }
                });
            }

            $('.category-checkbox, .need-checkbox').change(function () {
                fetchFilteredData();
            });

            $("#sortSelect").change(function () {
                fetchFilteredData();
            });
            $("#price-range").on('input', function () {
                const maxPrice = $(this).val();
                $('#max-price').text(Number(maxPrice).toLocaleString('vi-VN') + " VND");
                fetchFilteredData();
            });
        });

    </script>
}


<style>
    .sort-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }

    .show-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }
</style>