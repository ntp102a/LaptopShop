
@model List<Product>
@{
    ViewData["Title"] = ViewBag.CurrentPage;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- SECTION -->
<div class="section">
    <!-- container -->
    <div class="container">
        <!-- row -->
        <div class="row">
            <!-- ASIDE -->
            <div id="aside" class="col-md-3">
                <!-- aside Widget -->
                <div class="aside">
                    <h3 class="aside-title">Hãng</h3>
                    <div class="checkbox-filter">
                        @foreach (var item in ViewBag.Categories)
                        {
                            <div class="input-checkbox">
                                <input type="checkbox" id="brand-@item.CategoryId" class="category-checkbox" data-category-id="@item.CategoryId">
                                <label for="brand-@item.CategoryId">
                                    <span></span>
                                    @item.CategoryName
                                </label>
                            </div>
                        }
                    </div>
                </div>
                <!-- /aside Widget -->
            </div>
            <!-- /ASIDE -->
            <!-- STORE -->
            <div id="store" class="col-md-9">
                <!-- store top filter -->
                <div class="store-filter clearfix">
                    <div class="store-sort">
                        <label>
                            Sort:
                            <select id="sortSelect" class="sort-select">
                                <option value="0">Tất cả</option>
                                <option value="1">Tăng dần theo giá</option>
                                <option value="2">Giảm dần theo giá</option>
                            </select>
                        </label>

                        <label>
                            Show:
                            <select id="pageSizeSelect" class="show-select">
                                <option value="12" selected>12</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                            </select>
                        </label>
                    </div>
                    
                </div>
                <!-- /store top filter -->
                <!-- store products -->
                <div class="row" id="records_table">
                    @if (Model != null)
                    {
                        @foreach (var item in Model)
                        {
                            string url = $"/Product/Details/{item.ProductId}";
                            decimal oldPrice = item.Price ?? 0; // Giá cũ (nếu null, mặc định là 0)
                            decimal discount = item.Discount.HasValue ? item.Discount.Value : 0;

                            string formattedOldPrice = oldPrice.ToString("#,##0") + " VND";

                            decimal newPrice = oldPrice - (oldPrice * discount / 100); // Giá mới
                            string formattedNewPrice = newPrice.ToString("#,##0") + " VND";

                            <!-- product 1 -->
                            <div class="col-md-4 col-xs-6">
                                <div class="product">
                                    <div class="product-img">
                                        <a href="@url">
                                            <img width="250" height="250" src="/images/products/@item.Image.ImageThumb" alt="">
                                        </a>
                                        <div class="product-label">
                                            @if (discount > 0)
                                            {
                                                <span class="sale">-@discount%</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="product-body">
                                        <h3 class="product-name"><a href="@url">@item.ProductName</a></h3>
                                        <h4 class="product-price">
                                            @if (discount <= 0)
                                            {
                                                <del>@formattedOldPrice</del>
                                            }
                                            @formattedNewPrice
                                        </h4>
                                    </div>
                                    <div class="add-to-cart">
                                        <button class="add-to-cart-btn">
                                            <i class="fa fa-shopping-cart"></i>
                                            Thêm vào giỏ hàng
                                            <input hidden asp-for="@item.ProductId" />
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <!-- /product -->
                            <div class="clearfix visible-sm visible-xs"></div>
                        }
                    }
                </div>
            </div>
            <!-- /STORE -->
        </div>
        <!-- /row -->
    </div>
    <!-- /container -->
</div>
<!-- /SECTION -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<style>
    .sort-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }

    .show-select {
        padding: 0px 15px;
        background: #FFF;
        border: 1px solid #E4E7ED;
        height: 40px;
    }
</style>
@section Scripts {
    <script>
        $(document).ready(function () {
            $(function () {
                $(".add-to-cart-btn").click(function () {
                    var productid = $(this).find("input").val();
                    $.ajax({
                        url: '/api/cart/add',
                        type: "POST",
                        dataType: "JSON",
                        data: {
                            productID: productid
                        },
                        success: function (response) {
                            if (response.result == 'Redirect') {
                                window.location = response.url;
                            }
                            else {
                                loadHeaderCart();
                                location.reload();
                            }
                            console.log(response);
                        },
                        error: function (error) {
                            alert("Lỗi đẩy dữ liệu lên server" + error.responseText);
                        }
                    });
                });
            });

            function loadHeaderCart() {
                $("#headerCart").load("/AjaxContent/HeaderCart");
            }
        });
    </script>
}