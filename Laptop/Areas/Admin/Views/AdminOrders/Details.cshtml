@model LaptopShop.Models.Order

@{
    ViewData["Title"] = "Chi tiết hoá đơn #" + Model.OrderId;
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    List<OrderDetail> orderDetails = ViewBag.ChiTiet;
}
<div class="page-header">
    <div class="header-sub-title">
        <nav class="breadcrumb breadcrumb-dash">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="breadcrumb-item"><i class="anticon anticon-home m-r-5"></i>Home</a>
            <a class="breadcrumb-item" asp-area="Admin" asp-controller="AdminOrders" asp-action="Index" asp-route-id="@ViewBag.ClassifyId">Danh sách đơn hàng</a>
            <span class="breadcrumb-item active">Chi tiết hoá đơn</span>
        </nav>
    </div>
</div>

<div>
    <div class="card">
        <div class="card-body">
            <div id="invoice" class="p-h-30">
                <div class="row m-t-20 lh-2">
                    <div class="col-sm-6">
                        <h3 class="p-l-10 m-t-10">Hoá đơn</h3>
                        <address class="p-l-10 m-t-10">
                            <strong class="text-dark" title="">Tên người nhận: <br /></strong>
                            <span> @Model.User.FullName</span><br />
                            <strong class="text-dark" title="">Địa chỉ giao hàng: <br /></strong>
                            <span> @Model.Address</span><br />
                            <strong class="text-dark" title="">Số điện thoại:<br /></strong>
                            <span> @Model.User.Phone</span><br />
                            <strong class="text-dark" title="">Ghi chú:<br /></strong>
                            <span> @Model.Note</span>
                        </address>
                    </div>
                    <div class="col-sm-6">
                        <div class="m-t-80">
                            <div class="text-dark text-uppercase d-inline-block">
                                <span class="font-weight-semibold text-dark">Mã hoá đơn</span>
                            </div>
                            <div class="float-right">#@Model.OrderId</div>
                        </div>
                        <div class="text-dark text-uppercase d-inline-block">
                            <span class="font-weight-semibold text-dark">Ngày mua: </span>
                            <div class="float-right">@Model.OrderDate</div>
                        </div>
                        <br />
                        <div class="text-dark text-uppercase d-inline-block">
                            <span class="font-weight-semibold text-dark">Trạng thái: </span>
                            <div class="float-right"> @Model.Status.Status</div>
                        </div>
                        <br />
                        <div class="text-dark text-uppercase d-inline-block">
                            <span class="font-weight-semibold text-dark">Thanh toán: </span>
                            @if (Model.IsPayment == true)
                            {
                                <div class="float-right"> Đã thanh toán</div>
                            }
                            else
                            {
                                <div class="float-right"> Chưa thanh toán</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="m-t-10">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Tên sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Giá</th>
                                    <th>Tổng tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (orderDetails != null && orderDetails.Count() > 0)
                                {
                                    int i = 1;
                                    foreach (var item in orderDetails)
                                    {
                                        string url = $"/san-pham/{item.Product.ProductName}";
                                        <tr>
                                            <th>@i</th>
                                            <td><a href="@url">@item.Product.ProductName</a></td>
                                            <td>@item.Quantity</td>
                                            <td>@item.Price.Value.ToString("#, ##0") VND</td>
                                            <td>@item.Price.Value.ToString("#, ##0") VND</td>
                                        </tr>
                                        i++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row m-t-60 lh-1-8">
                        <div class="col-sm-12">
                            <div class="float-right text-right">
                                <h3><span class="font-weight-semibold text-dark">Tổng tiền :</span>@Model.Total.Value.ToString("#,##0") VND</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

